# Browser map / Street View. Restrict this key by HTTP referrer in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Keep server-side Places calls on a separate restricted key.
GOOGLE_PLACES_API_KEY=

# Amadeus Self-Service API. Use test.api.amadeus.com while developing.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Optional live webcam layer.
WINDY_WEBCAMS_API_KEY=

# Optional future provider adapter. Skyscanner requires partner approval.
SKYSCANNER_API_KEY=
