{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlas-viagem-audience",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/dashboard", "/dashboard/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "atlas-viagem-audience", "migrations_dir": "server/migrations" }],
  "vars": {
    "SITE_ORIGINS": "https://atlas-nine-vert.vercel.app",
    "MAX_RECORDS_PER_DAY": "5000"
  },
  "triggers": { "crons": ["0 5 * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
